# ── Server ────────────────────────────────────────────────────────────────────
PORT=3210
ALLOW_ORIGIN=http://localhost:3210

# ── Ollama LLM ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi3.5:latest
PREFERRED_OLLAMA_MODELS=phi3.5:latest,phi3.5,llama3.2:3b

# ── NLP Pipeline ─────────────────────────────────────────────────────────────
MAX_CONTEXT_TURNS=14
MAX_INPUT_CHARS=420
RETRIEVAL_TOP_K=4
MIN_RETRIEVAL_CONFIDENCE=0.22

# ── Response Quality ─────────────────────────────────────────────────────────
STRICT_DEMO_MODE=false
MAX_RESPONSE_SENTENCES=3

# ── Timeouts ─────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT_MS=30000
LLM_MAX_SILENCE_MS=25000
ACK_INTERVAL_MS=1400

# ── Optional: WebSocket auth token (leave empty for no auth) ─────────────────
WS_AUTH_TOKEN=

# ── Optional: Custom data directory ──────────────────────────────────────────
# BMU_GLOBAL_DATA_DIR=
